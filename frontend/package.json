{
  "name": "react-fastapi-base-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node server.mjs",
    "check:architecture": "node scripts/architecture-check.mjs",
    "check:contracts": "python ../scripts/generate_contracts.py --check",
    "test:server": "node --test tests/server.test.mjs",
    "prebuild": "node scripts/prepare-lab.mjs",
    "predev": "node scripts/prepare-lab.mjs",
    "lab:typecheck": "tsc -p ../experience-lab/tsconfig.json --noEmit",
    "storybook": "storybook dev --port 6006 --host 127.0.0.1",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "@tanstack/react-query": "5.102.8",
    "ag-grid-community": "36.1.0",
    "ag-grid-react": "36.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "vitest": "4.1.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/node": "22.10.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "26.1.0",
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.13.0",
    "storybook": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-a11y": "10.6.0"
  }
}
