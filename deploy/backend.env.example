# Copy into the company PaaS configuration UI, not a committed .env file.
# The platform owns AccessKey. Never set every user's identity to the app owner.
BASE_ENVIRONMENT=production
BASE_PROFILE=company
BASE_DATA_ROOT=/approved/persistent/golden
BASE_APP_CONFIG=/approved/config/application.json
BASE_POLICY_CONFIG=/approved/config/permissions.json
BASE_DEV_USER=demo.admin
BASE_DEPLOYMENT_ID=replace-with-the-real-deployment-id
# Independent publisher topology: this is the public frontend origin and the
# backend host accepted by the ASGI service. Same-origin ingress is separate.
BASE_ALLOWED_ORIGINS=["https://frontend.company.example"]
BASE_ALLOWED_HOSTS=["backend.company.example"]
# Qualification bootstrap (use this environment before the final drills):
# BASE_ENVIRONMENT=qualification
# BASE_QUALIFICATION_PREREQUISITES_FILE=/approved/operator/company-qualification-prerequisites.json
# Final production (use only after authorized qualification approval):
# BASE_QUALIFICATION_FILE=/approved/operator/company-qualification.json
# Inject a cryptographically random value through the platform secret mechanism.
# No usable default is provided. Production refuses a missing/short secret.
BASE_CSRF_SECRET=replace-with-platform-secret
BASE_BUSY_TIMEOUT_MS=5000
BASE_MAX_REQUEST_BYTES=2000000
BASE_REQUEST_LIMIT_PER_MINUTE=180
BASE_ENABLE_DOCS=false
BASE_WEBHOOK_ALLOWED_HOSTS=[]
BASE_ATTACHMENT_UPLOAD_MODE=scanner_required
PORT=8000
