# For native Node static publisher only. For static publishing, configure equivalent headers.
NODE_ENV=production
PORT=4173
HOST=0.0.0.0
BASE_FRONTEND_HOSTS=["frontend.company.example"]
# Optional absolute nonsecret runtime-config path, owned by the operator.
# For independent publishers its four-field JSON apiBase must be the exact
# separately published backend origin, with no path, credentials or slash.
BASE_FRONTEND_RUNTIME_CONFIG=/approved/config/runtime-config.json
